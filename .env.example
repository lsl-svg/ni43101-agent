# ---- Extractor (强模型) ----
# provider: openai | deepseek | dashscope(qwen) | zhipu(glm) | openai_compatible
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
ZHIPU_API_KEY=

# 自定义 OpenAI 兼容端点（provider=openai_compatible 时必填）
OPENAI_BASE_URL=
OPENAI_COMPAT_API_KEY=

# ---- 运行参数（可被 config/settings.yaml 覆盖）----
NI_MAX_ROUNDS=3
NI_PASS_SCORE=8.0
NI_CONSISTENCY_TOL=0.05
